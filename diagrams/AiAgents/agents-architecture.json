  "cards": [
    {
      "dot": "cyan",
      "title": "Configured once, by us",
      "items": [
        "PerfeXe staff define an agent in the Super Admin portal: what it is, how it should behave, and the template of steps it follows",
        "That definition lives in one global catalog database — no customer data ever sits here",
        "Publishing a new version never changes an agent a workspace is already using"
      ]
    },
    {
      "dot": "emerald",
      "title": "Owned by the workspace once hired",
      "items": [
        "Hiring copies the whole configuration into that workspace's own database",
        "The workspace admin can rewrite the instructions or change the template — those edits stay in their database only",
        "Every table is tenant-filtered fail-closed: with no workspace resolved, nothing comes back"
      ]
    },
    {
      "dot": "amber",
      "title": "The orchestrator is a guest, not a partner",
      "items": [
        "PerfeXe never calls the orchestrator — our UI does, and posts the exchange back to us",
        "The orchestrator reads configuration, knowledge and the workspace's LLM key through one guarded door",
        "An active hire is the permission; ending the hire cuts access on the very next call"
      ]
    }
  ]
